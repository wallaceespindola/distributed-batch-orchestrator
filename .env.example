# Copy to .env and adjust as needed. Never commit the real .env file.

# --- Local mode (default) ---

# Port this instance listens on. Local mode runs 6 instances: 8080-8085.
SERVER_PORT=8080

# Unique identifier for this instance, used for partition attribution and master election.
APP_INSTANCE_ID=instance-8080

# Comma-separated base URLs of all peer instances (used for local-mode master
# election / distribution simulation, without Kafka).
APP_PEERS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:8085

# Number of randomly generated bank accounts (10-100, configurable).
APP_DATA_ACCOUNTS=25

# Active Spring profile. `local` is the default; set to `kubernetes` to enable
# Kafka remote partitioning instead of the local distribution simulation.
SPRING_PROFILES_ACTIVE=local

# --- Kubernetes mode only ---

# Kafka bootstrap servers, only used when SPRING_PROFILES_ACTIVE=kubernetes.
KAFKA_BOOTSTRAP=localhost:9094

# H2 TCP database URL, only used when SPRING_PROFILES_ACTIVE=kubernetes.
# Default in-cluster value: jdbc:h2:tcp://h2:9092//data/orchestrator
# DB_URL=jdbc:h2:tcp://h2:9092//data/orchestrator

# Shared secret for instance-to-instance partition dispatch (override in any non-local deployment)
APP_INTERNAL_TOKEN=local-dev-internal-token
